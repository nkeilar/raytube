+package airplay
+
+import (
+	"math/rand"
+	"testing"
+)
+
+// findStartCode must match the original byte-at-a-time scan exactly.
+func TestFindStartCodeMatchesBytewise(t *testing.T) {
+	r := rand.New(rand.NewSource(1))
+	for n := 0; n < 1_000_000; n++ {
+		b := make([]byte, r.Intn(24))
+		for i := range b {
+			// Mostly 0x00 and 0x01 so start codes and near misses are common.
+			switch r.Intn(4) {
+			case 0, 1:
+				b[i] = 0x00
+			case 2:
+				b[i] = 0x01
+			default:
+				b[i] = byte(r.Intn(256))
+			}
+		}
+		from := r.Intn(len(b)+3) - 2
+		if got, want := findStartCode(b, from), findStartCodeBytewise(b, from); got != want {
+			t.Fatalf("findStartCode(% x, %d) = %d, want %d", b, from, got, want)
+		}
+	}
+}
+
+func BenchmarkFindStartCode(b *testing.B) {
+	data := make([]byte, 300_000) // a typical 1440p access unit
+	rand.New(rand.NewSource(2)).Read(data)
+	for i := range data {
+		if data[i] == 0x01 && i >= 2 && data[i-1] == 0 && data[i-2] == 0 {
+			data[i] = 0x02 // no accidental start codes in the payload
+		}
+	}
+	copy(data[0:], []byte{0, 0, 0, 1})
+	b.Run("vectorised", func(b *testing.B) {
+		for i := 0; i < b.N; i++ {
+			_ = splitAnnexBAccessUnit(data)
+		}
+	})
+	b.Run("bytewise", func(b *testing.B) {
+		for i := 0; i < b.N; i++ {
+			for s := findStartCodeBytewise(data, 0); s >= 0; s = findStartCodeBytewise(data, s+3) {
+			}
+		}
+	})
+}
