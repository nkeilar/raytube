+
+// ffmpegPipelineSplit marks where buildGstVideoPipeline hands raw Y4M frames to
+// ffmpeg. It never reaches gst-launch-1.0.
+const ffmpegPipelineSplit = "__doubletake_ffmpeg_split__"
+
+// selectFFmpegVAAPIEncoder chooses ffmpeg's h264_vaapi on an Intel render node.
+// GStreamer's va plugin cannot encode on the legacy i965 driver, but ffmpeg can.
+// DOUBLETAKE_VAAPI_DEVICE overrides the auto-detected device.
+func selectFFmpegVAAPIEncoder(announce bool, bitrate, keyframeInterval int) (encoderResult, error) {
+	if _, err := exec.LookPath("ffmpeg"); err != nil {
+		return encoderResult{}, fmt.Errorf("-hwaccel intel requires ffmpeg in PATH")
+	}
+	device := os.Getenv("DOUBLETAKE_VAAPI_DEVICE")
+	if device == "" {
+		device = findIntelRenderNode()
+	}
+	if device == "" {
+		return encoderResult{}, fmt.Errorf("-hwaccel intel found no i915 render node; set DOUBLETAKE_VAAPI_DEVICE")
+	}
+	if announce {
+		log.Printf("[CAPTURE] using ffmpeg VA-API hardware encoding (h264_vaapi on %s)", device)
+	}
+	return encoderResult{
+		rawFormat: "I420",
+		codec:     VideoCodecH264,
+		ffmpegEncode: &ffmpegVAAPIEncoder{
+			device:           device,
+			bitrateKbps:      bitrate,
+			keyframeInterval: keyframeInterval,
+		},
+	}, nil
+}
+
+func findIntelRenderNode() string {
+	nodes, _ := filepath.Glob("/sys/class/drm/renderD*")
+	for _, node := range nodes {
+		driver, err := os.Readlink(filepath.Join(node, "device", "driver"))
+		if err == nil && filepath.Base(driver) == "i915" {
+			return "/dev/dri/" + filepath.Base(node)
+		}
+	}
+	return ""
+}
+
+// newVideoCaptureCommand runs gstArgs directly, or for an ffmpeg encoder splits
+// them into capture | ffmpeg | packetize under bash. Inherited ExtraFiles (the
+// PipeWire fd) reach the first stage unchanged. Each stage gets a parent-death
+// SIGKILL, because a VA-API encoder blocked in the driver ignores EOF/EPIPE
+// and would otherwise outlive the stream.
+func newVideoCaptureCommand(ctx context.Context, gstArgs []string, encoder encoderResult, maxWidth, maxHeight int) *exec.Cmd {
+	if encoder.ffmpegEncode == nil {
+		return exec.CommandContext(ctx, "gst-launch-1.0", gstArgs...)
+	}
+	split := -1
+	for i, arg := range gstArgs {
+		if arg == ffmpegPipelineSplit {
+			split = i
+			break
+		}
+	}
+	if split < 1 {
+		panic("ffmpeg encoder pipeline is missing its split marker")
+	}
+	capture := append(append([]string{}, gstArgs[:split-1]...), "!", "fdsink", "fd=1", "sync=false")
+	packetize := append([]string{"--quiet", "fdsrc", "fd=0", "do-timestamp=true"}, gstArgs[split+1:]...)
+
+	stage := func(name string, args []string) string {
+		return shellJoin(append([]string{"setpriv", "--pdeathsig", "KILL", name}, args...))
+	}
+	script := "set -o pipefail; " +
+		stage("gst-launch-1.0", capture) + " | " +
+		stage("ffmpeg", encoder.ffmpegEncode.args(maxWidth, maxHeight)) + " | " +
+		stage("gst-launch-1.0", packetize)
+	dbg("[CAPTURE] ffmpeg pipeline: %s", script)
+	return exec.CommandContext(ctx, "bash", "-c", script)
+}
+
+func (e *ffmpegVAAPIEncoder) args(maxWidth, maxHeight int) []string {
+	// Fit and pad on the GPU. Keeping the capture's native pixels (padding rather
+	// than upscaling) keeps text sharp and leaves final scaling to the receiver.
+	filter := "hwupload,scale_vaapi=format=nv12"
+	if maxWidth > 0 && maxHeight > 0 {
+		w, h := maxWidth&^1, maxHeight&^1
+		filter = fmt.Sprintf("hwupload,scale_vaapi=w=%d:h=%d:force_original_aspect_ratio=decrease:force_divisible_by=2:format=nv12,pad_vaapi=w=%d:h=%d:x=-1:y=-1", w, h, w, h)
+	}
+	// DOUBLETAKE_FFMPEG_ASYNC_DEPTH: frames the encoder may hold in flight.
+	// 1 hands each frame out as soon as it is encoded (ffmpeg's default is 2).
+	asyncDepth := "1"
+	if v := os.Getenv("DOUBLETAKE_FFMPEG_ASYNC_DEPTH"); v != "" {
+		asyncDepth = v
+	}
+	return []string{
+		"-hide_banner", "-loglevel", "warning", "-nostdin",
+		"-fflags", "nobuffer", "-f", "yuv4mpegpipe", "-i", "-",
+		"-vaapi_device", e.device, "-vf", filter,
+		"-c:v", "h264_vaapi", "-async_depth", asyncDepth, "-rc_mode", "CBR",
+		// A rate-control buffer of 1/4 s bounds keyframe bursts; the default
+		// (maxrate, i.e. 1 s) lets them queue up on the network.
+		"-b:v", fmt.Sprintf("%dk", e.bitrateKbps), "-maxrate", fmt.Sprintf("%dk", e.bitrateKbps),
+		"-bufsize", fmt.Sprintf("%dk", max(e.bitrateKbps/4, 1)),
+		"-g", fmt.Sprintf("%d", e.keyframeInterval), "-bf", "0", "-aud", "1",
+		"-flush_packets", "1", "-f", "h264", "-",
+	}
+}
+
+func shellJoin(args []string) string {
+	quoted := make([]string, len(args))
+	for i, arg := range args {
+		quoted[i] = "'" + strings.ReplaceAll(arg, "'", `'\''`) + "'"
+	}
+	return strings.Join(quoted, " ")
+}
+
+// wfRecorderPath returns DOUBLETAKE_WF_RECORDER: a wf-recorder built with
+// cross-device DMA-BUF support. When set, Wayland capture bypasses the portal
+// and PipeWire: wf-recorder takes damage-only wlr-screencopy frames into a
+// LINEAR buffer on the Intel GPU (the compositor GPU renders into it), then
+// VA-API converts, pads and encodes there. No pixel work touches the CPU.
+func wfRecorderPath() string {
+	return os.Getenv("DOUBLETAKE_WF_RECORDER")
+}
+
+func startWfRecorderCapture(ctx context.Context, cfg CaptureConfig, encoder encoderResult, timestampedOutput bool) (*ScreenCapture, error) {
+	if encoder.ffmpegEncode == nil {
+		return nil, fmt.Errorf("wf-recorder capture requires -hwaccel intel")
+	}
+	captureCtx, cancel := context.WithCancel(ctx)
+	e := encoder.ffmpegEncode
+
+	// Fit to the canvas, pad while still RGB, then convert: pad_vaapi on NV12
+	// fills the bars with zero YUV, which is green, and pad alone cannot shrink
+	// a screen larger than the canvas (e.g. 2880x1800 into 1920x1080).
+	// DOUBLETAKE_NO_PAD=1 when the captured output is already the canvas size
+	// (raytube's TV desktop): the pad pass is a full-frame GPU copy that does
+	// nothing but costs CPU and drops frames.
+	filter := "scale_vaapi=format=nv12"
+	if cfg.MaxWidth > 0 && cfg.MaxHeight > 0 && os.Getenv("DOUBLETAKE_NO_PAD") == "" {
+		w, h := cfg.MaxWidth&^1, cfg.MaxHeight&^1
+		filter = fmt.Sprintf("scale_vaapi=w=%d:h=%d:force_original_aspect_ratio=decrease:force_divisible_by=2,pad_vaapi=w=%d:h=%d:x=-1:y=-1:color=black,scale_vaapi=format=nv12", w, h, w, h)
+	}
+	fps := cfg.FPS
+	if fps <= 0 {
+		fps = 30
+	}
+	asyncDepth := "1"
+	if v := os.Getenv("DOUBLETAKE_FFMPEG_ASYNC_DEPTH"); v != "" {
+		asyncDepth = v
+	}
+	wfArgs := []string{
+		"-c", "h264_vaapi", "-d", e.device, "-F", filter,
+		// -B gives the encoder the real frame rate (without it VA-API rate
+		// control assumes ~65535 fps and starves every frame) and caps the
+		// damage-driven capture rate to match.
+		"-B", fmt.Sprintf("%d", fps),
+		// VBR with 2x peaks and a 1 s buffer: screen changes are bursty, and a
+		// tight CBR buffer makes i965 BRC "underflow" and smear until the next IDR.
+		"-p", "rc_mode=VBR",
+		"-p", fmt.Sprintf("b=%dk", e.bitrateKbps), "-p", fmt.Sprintf("maxrate=%dk", 2*e.bitrateKbps),
+		"-p", fmt.Sprintf("bufsize=%dk", 2*e.bitrateKbps),
+		"-p", fmt.Sprintf("g=%d", e.keyframeInterval), "-p", "bf=0",
+		"-p", "async_depth=" + asyncDepth, "-p", "aud=1",
+		"-m", "h264", "-f", "pipe:1",
+	}
+	// DOUBLETAKE_WF_ARGS appends wf-recorder options, e.g. "-D" to capture
+	// every compositor frame (capped at -B) instead of damage-only.
+	wfArgs = append(wfArgs, strings.Fields(os.Getenv("DOUBLETAKE_WF_ARGS"))...)
+	packetize := []string{"--quiet", "fdsrc", "fd=0", "do-timestamp=true"}
+	for _, stage := range packetizeStages(encoder.codec, timestampedOutput) {
+		packetize = append(packetize, "!")
+		packetize = append(packetize, stage...)
+	}
+	stage := func(name string, args []string) string {
+		return shellJoin(append([]string{"setpriv", "--pdeathsig", "KILL", name}, args...))
+	}
+	script := "set -o pipefail; " + stage(wfRecorderPath(), wfArgs) + " | " + stage("gst-launch-1.0", packetize)
+	log.Printf("[CAPTURE] using wf-recorder screencopy capture (zero-copy DMA-BUF, VA-API on %s)", e.device)
+	dbg("[CAPTURE] wf-recorder pipeline: %s", script)
+
+	cmd := exec.CommandContext(captureCtx, "bash", "-c", script)
+	cmd.Env = append(os.Environ(), "WF_FORCE_DMABUF=1", "WF_IMPLICIT_MODIFIER=1")
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		cancel()
+		return nil, fmt.Errorf("wf-recorder stdout pipe: %w", err)
+	}
+	stderr, _ := cmd.StderrPipe()
+	waitResult, err := startGStreamerCommand(cmd)
+	if err != nil {
+		cancel()
+		return nil, fmt.Errorf("start wf-recorder: %w", err)
+	}
+	go logStderr("WF", stderr)
+
+	capture := &ScreenCapture{
+		cmd:    cmd,
+		stdout: stdout,
+		cancel: cancel,
+		waitCh: make(chan struct{}),
+	}
+	if timestampedOutput {
+		capture.frames = newRTPVideoAccessUnitReader(stdout, encoder.codec)
+	}
+	go func() {
+		capture.waitErr = <-waitResult
+		close(capture.waitCh)
+	}()
+	return capture, nil
+}
