 func findStartCode(b []byte, from int) int {
+	if from < 0 {
+		from = 0
+	}
+	// Jump between 0x01 bytes with the vectorised IndexByte and look back for
+	// the zeros, instead of testing every byte: 1080p/1440p access units are
+	// hundreds of KB with only a handful of start codes. Same results as
+	// findStartCodeBytewise, including ignoring a 3-byte code in the last byte.
+	for i := from + 2; i < len(b); {
+		j := bytes.IndexByte(b[i:], 0x01)
+		if j < 0 {
+			return -1
+		}
+		k := i + j
+		if b[k-1] == 0x00 && b[k-2] == 0x00 {
+			if k-3 >= from && b[k-3] == 0x00 {
+				return k - 3
+			}
+			if k+1 < len(b) {
+				return k - 2
+			}
+		}
+		i = k + 1
+	}
+	return -1
+}
