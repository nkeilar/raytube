+/// Counts of receiver feedback for the video stream between summaries.
+#[derive(Default)]
+struct ReceiverTelemetry {
+    checkpoints: u32,
+    nacks: u32,
+    picture_losses: u32,
+    decoded: u32,
+    rendered: u32,
+    render_delay_sum_ms: i64,
+    render_delay_min_ms: Option<i16>,
+    render_delay_max_ms: Option<i16>,
+}
+
+impl ReceiverTelemetry {
+    fn record(&mut self, event: &RtcpEvent) {
+        match *event {
+            RtcpEvent::Checkpoint { .. } => self.checkpoints += 1,
+            RtcpEvent::Nack { .. } => self.nacks += 1,
+            RtcpEvent::PictureLoss => self.picture_losses += 1,
+            RtcpEvent::FrameLog { kind: rtcp::FrameLogKind::Decoded, .. } => self.decoded += 1,
+            RtcpEvent::FrameLog { kind: rtcp::FrameLogKind::Rendered, delay_ms, .. } => {
+                self.rendered += 1;
+                self.render_delay_sum_ms += delay_ms as i64;
+                self.render_delay_min_ms = Some(self.render_delay_min_ms.map_or(delay_ms, |m| m.min(delay_ms)));
+                self.render_delay_max_ms = Some(self.render_delay_max_ms.map_or(delay_ms, |m| m.max(delay_ms)));
+            }
+            RtcpEvent::FrameLog { .. } => {}
+        }
+    }
+
+    fn log(&self, window: Duration) {
+        let secs = window.as_secs_f64().max(0.001);
+        let avg = if self.rendered > 0 { self.render_delay_sum_ms / self.rendered as i64 } else { 0 };
+        tracing::info!(
+            "receiver: decoded {:.1} fps, rendered {:.1} fps (render delay avg {} ms, min {:?}, max {:?}), \
+             checkpoints {}, nacks {}, keyframe requests {}",
+            self.decoded as f64 / secs,
+            self.rendered as f64 / secs,
+            avg,
+            self.render_delay_min_ms,
+            self.render_delay_max_ms,
+            self.checkpoints,
+            self.nacks,
+            self.picture_losses,
+        );
+    }
+}
+
