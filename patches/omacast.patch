+/// Run an external video command (stdout = video), with an optional audio-only
+/// gst-launch alongside it. The shell execs into the video command so killing
+/// the child kills the video process; gst gets a parent-death SIGKILL so it
+/// never outlives it.
+fn spawn_command(video: &[String], audio_gst: Option<Vec<String>>) -> Result<tokio::process::Child> {
+    anyhow::ensure!(!video.is_empty(), "video_command is empty");
+    let quote = |s: &str| format!("'{}'", s.replace('\'', "'\\''"));
+    let mut script = String::new();
+    if let Some(args) = audio_gst {
+        script.push_str("setpriv --pdeathsig KILL gst-launch-1.0 ");
+        script.push_str(&args.iter().map(|a| quote(a)).collect::<Vec<_>>().join(" "));
+        script.push_str(" >/dev/null & ");
+    }
+    script.push_str("exec ");
+    script.push_str(&video.iter().map(|a| quote(a)).collect::<Vec<_>>().join(" "));
+    tracing::debug!("spawning: bash -c {script}");
+    tokio::process::Command::new("bash")
+        .arg("-c")
+        .arg(&script)
+        .stdin(std::process::Stdio::null())
+        .stdout(std::process::Stdio::piped())
+        .stderr(gst_stderr())
+        .kill_on_drop(true)
+        .spawn()
+        .context("spawning video_command")
+}
