+    FrameLog {
+        rtp_timestamp: u32,
+        kind: FrameLogKind,
+        delay_ms: i16,
+    },
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum FrameLogKind {
+    AckSent,
+    Decoded,
+    Rendered,
+    PacketReceived,
+}
+
+pub const RTCP_PT_APPLICATION_DEFINED: u8 = 204;
+/// APP subtype carrying receiver frame logs (openscreen RtcpSubtype::kReceiverLog).
+const APP_SUBTYPE_RECEIVER_LOG: u8 = 2;
+
+/// Wire event types, legacy audio/video and unified (openscreen
+/// statistics_common.h WireType).
+fn frame_log_kind(wire: u8) -> Option<FrameLogKind> {
+    match wire {
+        1 | 5 | 11 => Some(FrameLogKind::AckSent),
+        2 | 6 | 12 => Some(FrameLogKind::Rendered),
+        3 | 7 | 13 => Some(FrameLogKind::Decoded),
+        4 | 8 | 14 => Some(FrameLogKind::PacketReceived),
+        _ => None,
+    }
+}
+
+/// APP "CAST" receiver log body after the sender SSRC and name words:
+/// per frame [rtp ts u32][num_events-1 u8 | base time u24] then per event
+/// [delay-or-packet-id u16][type u4 | time delta u12]
+/// (openscreen compound_rtcp_parser.cc ParseFrameLogMessages).
+fn parse_receiver_log(mut body: &[u8], events: &mut Vec<RtcpEvent>) -> Result<(), RtcpError> {
+    while !body.is_empty() {
+        if body.len() < 8 {
+            return Err(RtcpError::Truncated);
+        }
+        let rtp_timestamp = u32::from_be_bytes([body[0], body[1], body[2], body[3]]);
+        let num_events = 1 + body[4] as usize;
+        body = &body[8..];
+        for _ in 0..num_events {
+            if body.len() < 4 {
+                return Err(RtcpError::Truncated);
+            }
+            let delay_or_packet = u16::from_be_bytes([body[0], body[1]]);
+            let wire = body[2] >> 4;
+            body = &body[4..];
+            if let Some(kind) = frame_log_kind(wire) {
+                events.push(RtcpEvent::FrameLog {
+                    rtp_timestamp,
+                    kind,
+                    delay_ms: delay_or_packet as i16,
+                });
+            }
+        }
+    }
+    Ok(())
 }
 
